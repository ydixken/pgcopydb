Mutant: the group of the raw path opens without an xid of its own, so a group whose members change no row writes no commit record. Must fail: the void-delete case, on the origin after the void DELETE's commit.
Apply from the repository root with git apply, and never commit it applied.

diff --git a/src/bin/pgcopydb/ld_apply.c b/src/bin/pgcopydb/ld_apply.c
index ff05fb1..8386e3e 100644
--- a/src/bin/pgcopydb/ld_apply.c
+++ b/src/bin/pgcopydb/ld_apply.c
@@ -691,14 +691,6 @@ stream_apply_spool_group_open(StreamApplyContext *context)
 		return false;
 	}
 
-	/* a target transaction without an xid writes no commit record */
-	if (!pgsql_execute(&(context->applyPgConn), "SELECT txid_current()"))
-	{
-		/* errors have already been logged */
-		(void) stream_apply_group_rollback(context);
-		return false;
-	}
-
 	return true;
 }
 
