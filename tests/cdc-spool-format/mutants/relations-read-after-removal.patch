Mutant: the start reads the relation log after it removed the leftover and the last segment. Must fail: a relation log damaged below the length that the index record before a headed last segment holds ends every start with an error, and no file changes; the relation log of a start that removes a headed last segment is bound by the last index record of the segment before it.
Apply from the repository root with git apply, and never commit it applied.

--- a/src/bin/pgcopydb/ld_spool.c
+++ b/src/bin/pgcopydb/ld_spool.c
@@ -2132,6 +2132,7 @@
 	SpoolTail *tail;            /* where the writer appends, or NULL */
 	SpoolHeader header;         /* of the segment created when tail is NULL */
 	SpoolRelations relations;
+	uint64_t synced;
 } SpoolStart;
 
 
@@ -2246,8 +2247,9 @@
 	uint64_t synced = start->removed ? start->before.last.relationLogEnd :
 					  start->last.last.relationLogEnd;
 
-	if ((start->tail != NULL && !spool_tail_check(start->tail)) ||
-		!spool_relations_read(&start->relations, dirname, synced))
+	start->synced = synced;
+
+	if (start->tail != NULL && !spool_tail_check(start->tail))
 	{
 		return false;
 	}
@@ -2306,6 +2308,11 @@
 	if (start->removed &&
 		(!unlink_file(start->last.index) || !unlink_file(start->last.segment.filename) ||
 		 !spool_sync_directory(dirname)))
+	{
+		return false;
+	}
+
+	if (!spool_relations_read(&start->relations, dirname, start->synced))
 	{
 		return false;
 	}
