Mutant: spool_writer_commit ignores a COMMIT frame that the segment refused, and takes its record. Must fail: a COMMIT that the closed segment refuses is an error and gets no record.
Apply from the repository root with git apply, and never commit it applied.

--- a/src/bin/pgcopydb/ld_spool.c
+++ b/src/bin/pgcopydb/ld_spool.c
@@ -719,10 +719,7 @@ spool_writer_commit(SpoolWriter *writer, const char *m
 		return true;
 	}
 
-	if (!spool_append(&writer->segment, message, length))
-	{
-		return false;
-	}
+	(void) spool_append(&writer->segment, message, length);
 
 	writer->txn.seq = writer->nextSeq;
 	writer->txn.endOffset = spool_end(&writer->segment);
