@@ -629,8 +629,7 @@
 	pos = 0;
 	uint32_t crc = pgout_u32(message + length, &pos, 4);
 
-	if (crc != spool_relation_crc(buf, message, length) ||
-		!spool_relation_valid(message, length))
+	if (!spool_relation_valid(message, length))
 	{
 		return SPOOL_FRAME_BAD;
 	}
