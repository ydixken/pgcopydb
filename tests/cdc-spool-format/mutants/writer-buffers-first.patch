Mutant: spool_writer_create allocates its buffers before the create and keeps them when it fails. Must fail: a writer whose segment file name does not fit fails with an ERROR line and holds no buffer.
Apply from the repository root with git apply, and never commit it applied.

--- a/src/bin/pgcopydb/ld_spool.c
+++ b/src/bin/pgcopydb/ld_spool.c
@@ -1115,6 +1115,9 @@
 		.completeSize = SPOOL_HEADER_SIZE
 	};
 
+	initPQExpBuffer(&writer->held);
+	initPQExpBuffer(&writer->pendingIndex);
+
 	if (!spool_segment_create(&writer->segment, dirname, header))
 	{
 		return false;
@@ -1083,10 +1086,6 @@
 		spool_fail(&writer->segment);
 		return false;
 	}
-
-	/* after the create, so that a failed one leaves no buffer to free */
-	initPQExpBuffer(&writer->held);
-	initPQExpBuffer(&writer->pendingIndex);
 
 	return true;
 }
