Mutant: spool_hold ignores a PQExpBuffer that failed to grow, which drops the held BEGIN. Must fail: a held frame that cannot be stored in memory is an error.
Apply from the repository root with git apply, and never commit it applied.

--- a/src/bin/pgcopydb/ld_spool.c
+++ b/src/bin/pgcopydb/ld_spool.c
@@ -597,7 +597,7 @@ spool_hold(SpoolWriter *writer, const char *message, u
 	appendBinaryPQExpBuffer(&writer->held, lengthBytes, sizeof(lengthBytes));
 	appendBinaryPQExpBuffer(&writer->held, message, length);
 
-	if (PQExpBufferBroken(&writer->held))
+	if (false)
 	{
 		log_error(ALLOCATION_FAILED_ERROR);
 		return false;
