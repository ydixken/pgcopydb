Mutant: a failed cut of the last segment is ignored. Must fail: a cut that cannot truncate its file fails the start with an ERROR line that names it; a cut that cannot sync its file fails the start with an ERROR line that names it.
Apply from the repository root with git apply, and never commit it applied.

--- a/src/bin/pgcopydb/ld_spool.c
+++ b/src/bin/pgcopydb/ld_spool.c
@@ -2080,8 +2080,8 @@
 static bool
 spool_tail_cut(SpoolTail *tail)
 {
-	return spool_cut_file(tail->segment.fd, tail->segment.filename,
-						  tail->last.endOffset) &&
+	return (spool_cut_file(tail->segment.fd, tail->segment.filename,
+						   tail->last.endOffset) || true) &&
 		   spool_cut_file(tail->indexFd, tail->index, tail->keep);
 }
 
