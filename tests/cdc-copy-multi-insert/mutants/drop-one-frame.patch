+++ b/src/bin/pgcopydb/ld_spool.c
@@ -1406,6 +1406,11 @@ spool_writer_message(SpoolWriter *writer, const char *message, uint32_t length)
 
 	if (type == 'I' || type == 'U' || type == 'D' || type == 'T')
 	{
+		if (writer->txn.changes == 0)
+		{
+			return true;
+		}
+
 		writer->txn.changes++;
 	}
 
